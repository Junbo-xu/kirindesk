{
  "name": "@kirindesk/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "rollback": "tsx src/rollback.ts",
    "seed": "tsx src/seed.ts",
    "verify-chain": "tsx src/verify-chain.ts",
    "rehearse": "tsx src/rehearse.ts",
