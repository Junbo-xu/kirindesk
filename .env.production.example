# KirinDesk — production / private-deployment environment.
# Phase 3A. Copy to `.env.production` and replace every CHANGE_ME with a real
# value. NEVER commit the filled-in file (.gitignore ignores .env.production*).
#
# Credential separation (security-hardening-plan):
#   - DATABASE_URL (superuser) is used ONLY by the one-shot `migrate` container.
#   - APP_DATABASE_URL (kirindesk_app, non-superuser) is the ONLY DB credential
#     the running api container receives. The api startup self-check refuses to
#     run as a superuser.

NODE_ENV=production

# ── Postgres (the `postgres` service reads these) ───────────────────────────
POSTGRES_USER=kirindesk
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=kirindesk

# Superuser connection — MIGRATIONS ONLY. Host is the compose service name `postgres`.
DATABASE_URL=postgresql://kirindesk:CHANGE_ME_strong_db_password@postgres:5432/kirindesk

# App-role connection — RUNTIME ONLY (non-superuser, RLS-enforced).
# APP_DB_PASSWORD is injected into migration 000 to create/converge the
# kirindesk_app role. It MUST match the password embedded in APP_DATABASE_URL
# below (single source of truth for the app-role password).
APP_DB_PASSWORD=CHANGE_ME_strong_app_password
APP_DATABASE_URL=postgresql://kirindesk_app:CHANGE_ME_strong_app_password@postgres:5432/kirindesk

# ── Redis (host is the compose service name `redis`) ────────────────────────
REDIS_URL=redis://redis:6379

# ── Object storage (the bundled MinIO; host is the service name `minio`) ────
# The one-shot minio-init service creates this bucket idempotently.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=kirindesk-files
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_FORCE_PATH_STYLE=true

# ── Auth (dual JWT secrets — must be long, random, and DIFFERENT) ───────────
# Generate e.g. with: openssl rand -base64 48
TENANT_JWT_SECRET=CHANGE_ME_long_random_tenant_secret
TENANT_JWT_EXPIRES_IN=2h
PLATFORM_JWT_SECRET=CHANGE_ME_long_random_platform_secret
PLATFORM_JWT_EXPIRES_IN=2h

# ── Reverse proxy / web ─────────────────────────────────────────────────────
# Host port the nginx web container publishes (the only exposed port).
WEB_HTTP_PORT=8080

# ── CORS (off by default; same-origin via nginx needs no CORS) ──────────────
CORS_ENABLED=false
CORS_ORIGINS=

# ── Signup abuse mitigation (Phase 2B) ──────────────────────────────────────
SIGNUP_RATE_LIMIT_MAX=5
SIGNUP_RATE_LIMIT_WINDOW_SEC=3600

# Login protection is fail-closed when Redis is unavailable.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=900

# ── AI/OCR providers ────────────────────────────────────────────────────────
# Mock is the production-safe default. The real DeepSeek adapter is currently
# approved only for synthetic verification data. Inject DEEPSEEK_API_KEY from a
# secret binding, never by filling it into this file.
AI_OCR_PROVIDER=mock
AI_TEXT_PROVIDER=mock
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_TEST_BUDGET_CNY=1
DEEPSEEK_TEST_MAX_CALLS=1

# ── Notification email / SMTP (Phase 1N real-send) ───────────────────────────
# Leave blank (or omit entirely) to keep the mock provider active (safe default
# for dev/staging). Set SMTP_HOST to activate real email sending via nodemailer.
#
# Alibaba Cloud enterprise mail example:
#   SMTP_HOST=smtp.qiye.aliyun.com
#   SMTP_PORT=465
#   SMTP_USER=info@sailchip.com
#   SMTP_PASS=CHANGE_ME_aliyun_smtp_password
#   SMTP_FROM=info@sailchip.com
#
# Port 465 = implicit TLS (secure). Port 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
