{
  "name": "kirindesk",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check \"apps/api/{src,test}/**/*.ts\"",
    "format": "prettier --write \"apps/api/{src,test}/**/*.ts\"",
    "test": "pnpm -r --if-present test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @kirindesk/api test:integration",
    "test:security": "node scripts/security-regression.mjs",
    "test:e2e": "playwright test",
    "audit:prod": "node scripts/audit-production.mjs",
    "verify:migrations": "pnpm --filter @kirindesk/database rehearse",
    "verify:fast": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test:unit && pnpm audit:prod",
    "verify:full": "pnpm verify:fast && pnpm test:integration && pnpm verify:migrations && pnpm test:security && pnpm test:e2e",
    "verify": "pnpm verify:full",
    "db:migrate": "pnpm --filter @kirindesk/database migrate",
    "db:rollback": "pnpm --filter @kirindesk/database rollback",
    "db:seed": "pnpm --filter @kirindesk/database seed",
    "db:verify-chain": "pnpm --filter @kirindesk/database verify-chain"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0"
    }
  }
}
