# Database (superuser — used for migrations/admin operations)
DATABASE_URL=postgresql://kirindesk:kirindesk_dev_password@localhost:5432/kirindesk_dev
POSTGRES_USER=kirindesk
POSTGRES_PASSWORD=kirindesk_dev_password
POSTGRES_DB=kirindesk_dev

# Database (app role — used by application runtime, RLS enforced)
APP_DATABASE_URL=postgresql://kirindesk_app:kirindesk_app_dev_password@localhost:5432/kirindesk_dev

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001

# Web
WEB_PORT=3000

# Admin
ADMIN_PORT=3002

# Environment
NODE_ENV=development
