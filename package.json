{
  "name": "kirindesk",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format:check": "prettier --check \"apps/api/src/**/*.ts\"",
    "format": "prettier --write \"apps/api/src/**/*.ts\"",
    "test": "pnpm -r --if-present test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "db:migrate": "pnpm --filter @kirindesk/database migrate",
    "db:rollback": "pnpm --filter @kirindesk/database rollback",
    "db:seed": "pnpm --filter @kirindesk/database seed",
    "db:verify-chain": "pnpm --filter @kirindesk/database verify-chain"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
